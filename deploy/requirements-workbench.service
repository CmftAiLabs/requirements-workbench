[Unit]
Description=Requirements collaboration workbench
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=requirements
Group=requirements
SupplementaryGroups=docker
WorkingDirectory=/opt/requirements-workbench/current
Environment=NODE_ENV=production
Environment=PATH=/opt/requirements-workbench/runtime/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/requirements-workbench/runtime/bin/node --env-file=.env --import tsx server/index.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/requirements-workbench/shared

[Install]
WantedBy=multi-user.target
