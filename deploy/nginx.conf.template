# Render placeholders into a private file outside Git. HTTPS terminates here.
server {
    listen 80;
    server_name prototype.ai-native-lab.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    http2 on;
    server_name prototype.ai-native-lab.com;
    ssl_certificate __CERTIFICATE__;
    ssl_certificate_key __CERTIFICATE_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 55m;
    client_body_timeout 180s;
    auth_basic "Requirements Workbench";
    auth_basic_user_file __PASSWORD_FILE__;
    access_log /data/logs/requirements-workbench_access.log;
    error_log /data/logs/requirements-workbench_error.log warn;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location / {
        proxy_pass http://__PRIVATE_UPSTREAM__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Workbench-Token "__PROXY_ACCESS_TOKEN__";
        proxy_set_header Authorization "";
        proxy_set_header Connection "";
        proxy_read_timeout 3600s;
        proxy_send_timeout 180s;
        proxy_request_buffering off;
        proxy_buffering off;
    }
}
