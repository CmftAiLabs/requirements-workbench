# Copy this file to .env, replace the placeholders, and run chmod 600 .env.
# Keep database credentials and model tokens on the server only.
PORT=4318

DB_PORT=55438
DB_PASSWORD=replace_with_database_password
DATABASE_URL=postgresql://requirements:replace_with_database_password@127.0.0.1:55438/requirements
SESSION_SECRET=replace_with_at_least_32_random_characters

# Leave MODEL_API_KEY empty to run the workspace without paid model calls.
MODEL_BASE_URL=https://newapi.ai-native-lab.com/v1
MODEL_NAME=kimi-k3.1-pro
MODEL_API_KEY=
NODE_EXTRA_CA_CERTS=./certs/model-chain.pem

# Optional final-PRD delivery endpoints. Configure both to enable delivery.
KNOWLEDGE_DELIVERY_URL=
KNOWLEDGE_DELIVERY_TOKEN=
TEAMMATE_DELIVERY_URL=
TEAMMATE_DELIVERY_TOKEN=
